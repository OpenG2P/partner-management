# --- Login (shared commons IAM staff-portal-api; NSR pattern) ---
# The UI's /api/login, /api/me, /api/logout talk to this shared IAM service.
IAM_URL=http://commons-services-iam-staff-portal-api
KEYCLOAK_LOGOUT_URL=https://keycloak.openg2p.org/realms/staff/protocol/openid-connect/logout
LOGIN_PROVIDER_ID=1
COOKIE_DOMAIN=.openg2p.org
REDIRECT_URL=https://partner-management.openg2p.org

# --- Domain API (this repo's staff-portal-api) ---
# The BFF proxy at /api/pm/* forwards the staff Bearer token here.
STAFF_PORTAL_API_URL=http://partner-management-staff-portal-api
