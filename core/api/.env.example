# ---- Server ----
PARTNER_MANAGER_HOST=0.0.0.0
PARTNER_MANAGER_PORT=8000
PARTNER_MANAGER_WORKER_TYPE=gunicorn
PARTNER_MANAGER_NO_OF_WORKERS=1

# ---- Database ----
PARTNER_MANAGER_DB_DRIVER=postgresql+asyncpg
PARTNER_MANAGER_DB_HOSTNAME=localhost
PARTNER_MANAGER_DB_PORT=5432
PARTNER_MANAGER_DB_USERNAME=partner_management_user
PARTNER_MANAGER_DB_PASSWORD=change_me
PARTNER_MANAGER_DB_DBNAME=openg2p_partner_management_db

# ---- Key policy ----
# Comma / JSON list. Algorithms accepted on input and advertised on JWKS.
PARTNER_MANAGER_CRYPTO_ALLOWED_ALGORITHMS=["RS256","ES256","EdDSA"]
PARTNER_MANAGER_MIN_RSA_KEY_SIZE=2048
PARTNER_MANAGER_JWKS_FETCH_TIMEOUT=10
PARTNER_MANAGER_KEY_FETCH_CACHE_MAX_AGE=300

# ---- Admin auth: required role on the staff-realm token ----
PARTNER_MANAGER_AUTH_ADMIN_ROLE=partner_manager
PARTNER_MANAGER_AUTH_ADMIN_CLIENT_ID=partner-management

# ---- Admin auth: staff-realm JWT validation (consumed by openg2p-fastapi-auth) ----
# NOTE the COMMON_ prefix — the auth library reads these, not the service prefix.
COMMON_AUTH_ENABLED=true
COMMON_AUTH_DEFAULT_ISSUERS=["https://keycloak.openg2p.org/realms/staff"]
COMMON_AUTH_DEFAULT_JWKS_URLS=["https://keycloak.openg2p.org/realms/staff/protocol/openid-connect/certs"]
COMMON_AUTH_DEFAULT_AUDIENCES=[]

# For local development without Keycloak, disable auth entirely:
# COMMON_AUTH_ENABLED=false
